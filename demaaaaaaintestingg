EspButton.MouseButton1Click:Connect(function()
  esp_enabled = not esp_enabled
    toggleButton(EspButton, Frame2, esp_enabled)
    print("ESP:", esp_enabled and "enabled" or "disabled")
    
    espEnabled = esp_enabled
    
    if esp_enabled then
        -- ВКЛЮЧАЕМ ESP
        local c = workspace.CurrentCamera
        local ps = game:GetService("Players")
        local lp = ps.LocalPlayer
        local rs = game:GetService("RunService")
        
        local function removeESP(player)
            if espTexts[player] then
                espTexts[player]:Remove()
                espTexts[player] = nil
            end
        end
        
        local function esp(p, cr)
            if espTexts[p] then return end -- Уже есть ESP
            
            local h = cr:WaitForChild("Humanoid")
            local hrp = cr:WaitForChild("HumanoidRootPart")
        
            local text = Drawing.new("Text")
            text.Visible = false
            text.Center = true
            text.Outline = true 
            text.Font = 2
            text.Color = Color3.fromRGB(255, 255, 255)
            text.Size = 13
            
            espTexts[p] = text
        
            -- Проверка смерти
            local function checkHealth()
                if not cr or not h then return true end
                return h.Health <= 0 or h:GetState() == Enum.HumanoidStateType.Dead
            end
        
            rs.RenderStepped:Connect(function()
                if not espEnabled or checkHealth() or not cr.Parent then
                    removeESP(p)
                    return
                end
                
                local hrp_pos, hrp_onscreen = c:WorldToViewportPoint(hrp.Position)
                if hrp_onscreen then
                    text.Position = Vector2.new(hrp_pos.X, hrp_pos.Y - 50)
                    text.Text = p.Name .. " [" .. math.floor(h.Health) .. " HP]"
                    text.Visible = true
                else
                    text.Visible = false
                end
            end)
        end
        
        for _, p in pairs(ps:GetPlayers()) do 
            if p ~= lp and p.Character then
                esp(p, p.Character)
            end
            p.CharacterAdded:Connect(function(cr)
                if p ~= lp then
                    esp(p, cr)
                end
            end)
        end
        
    else
        -- ВЫКЛЮЧАЕМ И ОЧИЩАЕМ ESP
        for player, text in pairs(espTexts) do
            if text then
                text:Remove()
            end
        end
        espTexts = {}
    end
end)

TracersButton.MouseButton1Click:Connect(function()
	 tracers_enabled = not tracers_enabled
    toggleButton(TracersButton, Frame4, tracers_enabled)
    print("Tracers:", tracers_enabled and "enabled" or "disabled")
    
    if tracers_enabled then
        -- ВКЛЮЧАЕМ ТРЕЙСЕРЫ
        local players = game:GetService("Players")
        local runService = game:GetService("RunService")
        local camera = workspace.CurrentCamera
        local localPlayer = players.LocalPlayer
        
        tracersConnection = runService.RenderStepped:Connect(function()
            for _, player in ipairs(players:GetPlayers()) do
                if player ~= localPlayer then
                    local character = player.Character
                    local hrp = character and character:FindFirstChild("HumanoidRootPart")
                    
                    if character and hrp then
                        local pos, onScreen = camera:WorldToViewportPoint(hrp.Position)
                        
                        if onScreen then
                            if not tracersLines[player] then
                                tracersLines[player] = Drawing.new("Line")
                                tracersLines[player].Visible = true
                                tracersLines[player].Color = Color3.fromRGB(145, 112, 172)
                                tracersLines[player].Thickness = 2
                                tracersLines[player].Transparency = 1
                            end
                            
                            local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                            tracersLines[player].From = center
                            tracersLines[player].To = Vector2.new(pos.X, pos.Y)
                            tracersLines[player].Visible = true
                        else
                            if tracersLines[player] then
                                tracersLines[player].Visible = false
                            end
                        end
                    else
                        if tracersLines[player] then
                            tracersLines[player]:Remove()
                            tracersLines[player] = nil
                        end
                    end
                end
            end
        end)
        
    else
        -- ВЫКЛЮЧАЕМ И ОЧИЩАЕМ ТРЕЙСЕРЫ
        if tracersConnection then
            tracersConnection:Disconnect()
            tracersConnection = nil
        end
        
        for player, line in pairs(tracersLines) do
            if line then
                line:Remove()
            end
        end
        tracersLines = {}
    end
end)

