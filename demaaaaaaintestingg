-- Функция для переключения вкладок
local function switchTab(selectedTab)
	-- Скрыть все контенты
	VISUALSContent.Visible = false
	AIMContent.Visible = false
	MISCContent.Visible = false

	-- Скрыть все подсветки
	Highlight.Visible = false
	Highlight2.Visible = false
	Highlight3.Visible = false

	-- Показать выбранный контент и подсветку
	if selectedTab == "VISUALS" then
		VISUALSContent.Visible = true
		Highlight.Visible = true
	elseif selectedTab == "AIM" then
		AIMContent.Visible = true
		Highlight2.Visible = true
	elseif selectedTab == "MISC" then
		MISCContent.Visible = true
		Highlight3.Visible = true
	end
end

-- Функция для анимации переключения кнопок
local function toggleButton(button, frame, enabled)
	if enabled then
		-- Включено - переместить frame вправо
		frame:TweenPosition(UDim2.new(0.54, 2, 1.79, -30), "Out", "Quad", 0.2, true)
		frame.BackgroundColor3 = Color3.new(1, 0.333333, 0.333333)
	else
		-- Выключено - переместить frame влево
		frame:TweenPosition(UDim2.new(0.04, 2, 1.79, -30), "Out", "Quad", 0.2, true)
		frame.BackgroundColor3 = Color3.new(0.8, 0.8, 0.8)
	end
end

-- Функция для обновления значения слайдера FOV
local function updateFOVSlider(value)
	custom_fov_value = math.clamp(math.floor(value), 70, 120)
	CurrentFOVlabel.Text = tostring(custom_fov_value)
	local percentage = (custom_fov_value - 70) / (120 - 70)
	FOVSliderFrame.Size = UDim2.new(percentage, 0, 1, 0)
	FOVSlider.Position = UDim2.new(percentage, -5, 0.5, -5)

	-- Здесь можно добавить логику применения FOV к игре
	print("FOV:", custom_fov_value)
end

