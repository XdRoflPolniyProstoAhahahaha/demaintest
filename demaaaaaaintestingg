	UserImageLabel.Image = string.format("https://www.roblox.com/headshot-thumbnail/image?userId=%d&width=420&height=420&format=png", userId)

	-- Обновляем приветствие
	WelcomeLabel.Text = "Добро пожаловать, " .. player.Name .. "!"
end

